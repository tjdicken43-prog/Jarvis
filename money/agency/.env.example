# Names only. Real values live on Render, never in the repo or the notes.
DATABASE_URL=
OPERATOR_TOKEN=            # long random string; the dashboard sends it to the API
PUBLIC_URL=                # the API's public address, for unsubscribe links
ANTHROPIC_API_KEY=         # empty = template drafts
DRAFT_MODEL=claude-haiku-5-5
MAILER=stub                # stub sends nothing; smtp = Google Workspace
SMTP_USER=                 # the Workspace inbox on the cold domain
SMTP_PASSWORD=             # Workspace app password
FROM_EMAIL=
FROM_NAME=TJ
SENDER_BUSINESS=Sites by TJ
MAILING_ADDRESS=           # CAN-SPAM postal address or PO box; nothing sends without it
DAILY_SEND_CAP=5
CHROMIUM_PATH=            # optional: flaw finder browser when Playwright's own Chromium isn't installed
STRIPE_SECRET_KEY=        # sk_test_... only; a live key is refused unless STRIPE_ALLOW_LIVE=yes
STRIPE_WEBHOOK_SECRET=    # whsec_... for POST /stripe/webhook
STRIPE_ALLOW_LIVE=        # leave empty until TJ says go live
CHECKOUT_SUCCESS_URL=     # optional; default PUBLIC_URL/paid
CHECKOUT_CANCEL_URL=
VAPI_API_KEY=             # Vapi private key; empty = receptionist set-up is a dry run
VAPI_WEBHOOK_SECRET=      # long random string; Vapi sends it as X-Vapi-Secret; empty = webhook refuses
RECEPTIONIST_MODEL=claude-haiku-5-5
TEXTBACK=stub             # stub only: missed-call texts are recorded, never sent

# Optional tuning (defaults shown; leave unset to keep them)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# IMAP_HOST=imap.gmail.com
# SEND_HOUR_START=9          # send window, weekdays, Central
# SEND_HOUR_END=11
# MIN_RATING=2.8             # skip shops under this many stars
# FLAW_MAX_AGE_DAYS=7        # older flaw check at approve time: look at their site again
# SEND_FLAW_MAX_AGE_DAYS=14  # a first email never goes out on an older check
# REPEAT_FAILS=3             # failures in a row that stop a step until TJ looks
# STRIPE_FEE_PCT=2.9         # for the margin tracker (check against Stripe)
# STRIPE_FEE_CENTS=30
